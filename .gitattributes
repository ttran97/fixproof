# Generated evidence is byte-bound by SHA-256; never normalize it.
data/** -text
workspaces/** -text

* text=auto

*.py text eol=lf
*.ps1 text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.patch text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary

