# Generated workspaces are excluded by default, but the compact evidence files
# needed to audit selected experiments remain eligible for version control.
workspaces/**
!workspaces/**/
!workspaces/**/candidate.patch
!workspaces/**/workspace.json
!workspaces/**/app/**/*.js
!workspaces/**/app/**/*.json
!workspaces/**/app/**/*.txt
!workspaces/**/validation/*.json
.env
.env.local
.env.*.local

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Node.js
**/node_modules/
npm-debug.log*

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
dist/
