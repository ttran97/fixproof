  "candidate_contract": {
    "receives": [
      "canonical finding ID",
      "CWE and vulnerability category",
      "Semgrep rule ID, description, and provenance",
      "affected filename and code region",
      "focused surrounding source context",
      "minimal-remediation and behavior-preservation constraints"
    ],
    "withheld": [
      "ground-truth answers and reference patch",
      "security- and functional-test implementations",
      "hidden payload lists and expected test outputs",
      "results from other initial primary attempts",
      "authority to modify tests, validators, or scanner configuration",
      "authority to approve or deploy a candidate"
    ],
    "returns": [
      "canonical ID",
      "analysis",
      "remediation strategy",
      "complete replacement code for the supplied context",
      "assumptions",
      "additional-context flag"
    ]
  },
  "comparison": {
    "baseline": "sast_only_interpretation",
    "treatment": "fixproof_multistage_validation",
    "same_candidate_evidence_required": true,
    "sast_only_mapping": {
      "resolved": "APPARENT_SUCCESS",
      "persistent": "FAILURE",
      "scan_unavailable": "INCONCLUSIVE",
      "ignored_by_design": [
        "runtime security result",
        "functional result",
        "new SAST findings"
      ]
    },
    "fixproof_dispositions": [
      "REJECT",
      "READY_FOR_HUMAN_REVIEW",
      "NEEDS_HUMAN_ADJUDICATION"
    ],
    "automatic_production_acceptance": false
  },
  "primary_metrics": [
    "valid_candidate_generation_application_rate",
    "sast_remediation_success_rate",
    "targeted_security_pass_rate",
    "functional_preservation_rate",
    "new_finding_rate",
    "sast_only_apparent_success_rate",
    "fixproof_disposition_distribution",
    "sast_false_success_count_and_rate",
    "sast_runtime_disagreement_count_and_rate"
  ],
  "secondary_metrics": [
    "paired_retry_improvement_rate",
    "adjudication_completion_rate"
  ],
  "failure_handling": {
    "malformed_or_wrong_id_model_response": "Record as a primary model/candidate failure; do not silently regenerate.",
    "candidate_application_failure": "Record as a primary candidate failure.",
    "syntax_or_startup_failure": "Record as a failed candidate in the primary denominator.",
    "infrastructure_failure": "Document and rerun the affected stage with the same saved candidate when available; do not relabel it as remediation failure.",
